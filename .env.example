# Environment Configuration for AI Content Creator Marketplace
PROJECT_NAME="AI Content Creator Marketplace"
ENVIRONMENT=development
DEBUG=True

# Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default SQLite for development / hackathon
DATABASE_URL=sqlite:///./marketplace.db
# MySQL example:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/marketplace_db

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# AI Provider (Groq) - Optional, core marketplace features work without it
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
